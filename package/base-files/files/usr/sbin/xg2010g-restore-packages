#!/bin/sh
# Reinstall packages that the user installed into the overlay before a
# sysupgrade.  sbin/sysupgrade now always writes /etc/backup/installed_packages.txt;
# the configuration backup restores that file into the new image.
#
# Packages preinstalled by the old image are marked "rom" and are deliberately
# skipped: upgrading to the minimal image should not bring back optional
# packages that were shipped by the previous build.  Only overlay packages the
# user added are restored.  Packages already present in the new image have a
# /lib/apk/packages/<name>.list file and are skipped as well.

LIST=/etc/backup/installed_packages.txt
LOG=/tmp/xg2010g-restore.log
TAB="$(printf '\t')"

log() {
	echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$LOG"
	logger -t xg2010g-restore "$*"
}

[ -s "$LIST" ] || exit 0

log "checking user-installed packages from $LIST"

missing=""
while IFS="$TAB" read -r pkg origin; do
	[ -n "$pkg" ] || continue
	case "$origin" in
	overlay|unknown) ;;
	*) continue ;;
	esac
	[ -f "/lib/apk/packages/$pkg.list" ] && continue
	missing="$missing $pkg"
done <"$LIST"

if [ -z "$missing" ]; then
	log "no user-installed packages to restore"
	rm -f "$LIST"
	exit 0
fi

log "packages to restore:${missing}"

attempt=0
while :; do
	if apk update >>"$LOG" 2>&1; then
		break
	fi
	attempt=$((attempt + 1))
	if [ "$attempt" -ge 30 ]; then
		log "apk update failed after $attempt attempts; keeping the list for the next boot"
		exit 1
	fi
	sleep 10
done

failed=0
for pkg in $missing; do
	if apk add --no-cache "$pkg" >>"$LOG" 2>&1; then
		log "restored $pkg"
	else
		log "failed to restore $pkg"
		failed=1
	fi
done

if [ "$failed" -eq 0 ]; then
	log "package restore complete"
	rm -f "$LIST"
else
	log "some packages failed; keeping the list for the next boot"
fi

exit "$failed"
