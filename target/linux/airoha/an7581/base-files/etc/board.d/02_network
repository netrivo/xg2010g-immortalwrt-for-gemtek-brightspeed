. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

an7581_setup_interfaces()
{
	local board="$1"

	case "$board" in
	gemtek,xg2010g-ubi|\
	gemtek,xg2010g|\
	gemtek,xg2010g-2g-ubi|\
	gemtek,xg2010g-2g)
		ucidef_set_hostname "XG2010G"
		# Panel order is two RTL8261N 10G ports, EN8811H 2.5G, then switch 1G.
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "pon0"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
an7581_setup_interfaces $board
board_config_flush

exit 0
